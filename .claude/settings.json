{
  "permissions": {
    "allow": [
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(python -c ' *)",
      "PowerShell(npx playwright test --list*)",
      "Bash(npm run test:test *)",
      "Bash(npx playwright test *)",
      "Bash(npx cross-env ENV=test npx playwright test *)",
      "PowerShell(npm run test:test *)",
      "PowerShell(npx playwright test *)",
      "PowerShell(npx cross-env ENV=test npx playwright test *)",
      "Bash(npm run typecheck)",
      "Bash(npm run traceability)",
      "Bash(npm run migration:ledger)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["gitlab", "github"],
  "enabledPlugins": {
    "prompt-improver@severity1-marketplace": true
  },
  "extraKnownMarketplaces": {
    "severity1-marketplace": {
      "source": {
        "source": "github",
        "repo": "severity1/severity1-marketplace"
      }
    }
  }
}
