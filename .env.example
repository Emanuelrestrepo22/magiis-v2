# Plantilla para .env.test / .env.uat / .env.prod
# Copia este archivo a .env.<env> y completa los valores.
# IMPORTANTE: los .env.* NO se commitean (estan en .gitignore).
# NOTA: las URLs con # (hash) deben ir entrecomilladas porque dotenv las trata
# como comentario inline si no estan entre dobles comillas.

# ============================================================
# NUCLEO DEL FRAMEWORK - obligatorio en los 3 ambientes
# ============================================================

# === Entorno activo ===
ENV=test

# === Portal carrier V2 (Angular 18) ===
# URL real: apps-test.magiis.com/carrier/#/auth/login
BASE_URL=https://apps-test.magiis.com
LOGIN_PATH="/carrier/#/auth/login"
DASHBOARD_URL_PATTERN="/carrier/#/dashboard"

# === Credenciales por region ===
# Region primaria (usada por global-setup y tests sin region).
USER_CARRIER=
PASS_CARRIER=

# Region secundaria (opcional para tests parametrizados por region: AR, MX, US, ...).
USER_CARRIER_AR=
PASS_CARRIER_AR=

# === Playwright runtime ===
HEADLESS=true
WORKERS=4
RETRIES=0

# === Referencia a V1 (Angular 8) - solo cuando ENABLE_V1_PARITY_TESTS=true ===
# URL real: apps-test.magiis.com/#/authentication/login/carrier
BASE_URL_V1=https://apps-test.magiis.com
LOGIN_PATH_V1="/#/authentication/login/carrier"
ENABLE_V1_PARITY_TESTS=false

# ============================================================
# HERRAMIENTAS - interruptores opcionales, no dependen de ninguna pantalla.
# Comentados por defecto: descomentar solo cuando se necesitan.
# ============================================================

# Specs exploratorios (tests/specs/exploratory/, tag @explore): off por defecto
# para que no corran solos en un nightly.
# RUN_DISCOVERY=true

# Reporter de Allure (playwright.config.ts): falla al iniciar sobre npm + rutas
# OneDrive en esta maquina, por eso es opt-in.
# ALLURE=1

# Reporter de Xray (tests/utils/reporters/xray-reporter.ts): emite
# evidence/<env>/xray-results.json con los resultados mapeados por key de Test.
# XRAY=1
# XRAY_RESULTS_FILE=evidence/test/xray-results.json
# XRAY_EXECUTION_KEY=TM-1146     # importa contra un Test Execution existente. TM-1146 es el ATR
#                                de "estado vigente" del alta de viaje (MG-19): todas las corridas
#                                reportan ahi. Sin esta var el reporter CREA una Execution nueva.
# XRAY_TEST_PLAN_KEY=            # asocia la ejecucion nueva a un Test Plan (si XRAY_EXECUTION_KEY esta vacio)
# XRAY_SUMMARY=                  # titulo de la ejecucion nueva (si XRAY_EXECUTION_KEY esta vacio)
# XRAY_VERSION=                  # fixVersion de la ejecucion nueva (si XRAY_EXECUTION_KEY esta vacio)

# ============================================================
# FIXTURES POR PANTALLA - un dato que cada spec necesita porque ejercita datos
# reales del ambiente (un cliente, una cuenta con una integracion vinculada...).
#
# Viven en env vars y NO en un archivo de datos versionado por la misma razon
# que las credenciales de arriba: son datos provistos a mano en la base de cada
# ambiente (alguien los crea por afuera del codigo) y pueden cambiar en
# cualquier momento sin que eso amerite un commit. El prefijo identifica a que
# pantalla/historia pertenece cada bloque, para evitar choques de nombre entre
# dominios (ver CONVENTIONS.md SS4, patron de referencia MG19_CLIENT_QUERY).
# ============================================================

# --- Alta de Viaje / Nuevo Viaje (MG-19) ---
# Apellido con el que los specs de Nuevo Viaje buscan un cliente. La pantalla NO se puede
# ejercitar sin cliente: sin el, Pasajero y todo el bloque Ruta quedan deshabilitados.
# El typeahead consulta GET /passengers/carrier/<id>?lastName=<query> y pide 3+ caracteres.
#
# En TEST el valor que funciona es "federico": es un cliente que Fede dio de alta A MANO en
# el ambiente justamente para poder crear viajes. El default del codigo ("test") NO devuelve
# resultados en TEST y deja la suite en rojo con "el typeahead de cliente debe devolver al
# menos una opcion". En otros ambientes hay que apuntarlo a un cliente que exista ahi.
MG19_CLIENT_QUERY=federico

# (MG19_CREATE_TRIP retirado: el happy path TM-538 ya limpia lo que crea, cancela el viaje por UI en afterEach, politica G5.)

# Busqueda de vuelo asociado (modal de MU-039). Solo hacen falta si se corre
# new-trip-flight-accept-enablement.spec.ts contra un ambiente/cuenta distinto al del harness.
# MG19_AIRPORT_QUERY=Ezeiza
# MG19_AIRPORT_OPTION=Ezeiza|Ministro Pistarini
# MG19_AIRLINE_QUERY=Argentinas
# MG19_MISSING_FLIGHT_NUMBER=00000

# --- Integrations / App Store (MU-002) ---
# Cuenta contra la que corre app-store-gateway-linked.spec.ts. 'AR' es la unica con
# exactamente 1 pasarela vinculada hoy en TEST.
# APPSTORE_ACCOUNT=AR
# Nombre de la pasarela esperada vinculada en esa cuenta (ver el spec para el detalle).
# APPSTORE_LINKED_GATEWAY=

# Reporter de Xray - allowlist de keys (tests/utils/reporters/xray-reporter.ts): CSV de keys
# aceptadas; toda otra key se descarta y se cuenta. La fija scripts/run-xray-atr.ts por familia
# (othercosts = las 11 keys del ATR TM-1280), para que el ATR no crezca solo.
# XRAY_KEY_ALLOWLIST=
# Commit de la corrida para el comentario de medicion; run-xray-atr.ts lo completa con git.
# GIT_SHA=

# Reutilizar la sesion guardada storage/state-carrier-<env>.json sin login (global-setup.ts).
# Uso local del agente: si la sesion vencio, falla y la regenera un humano con npm run test:<env>.
# La familia npm run test:xray:othercosts la fija en 1 por defecto; login explicito = 0.
# REUSE_STORAGE_STATE=1

# Prefijo de la API de MAGIIS para los clientes de tests/api/clients (opcional; hay default).
# MAGIIS_API_PREFIX=

# --- Otros costos en Nuevo Viaje (MG-995 / MG-996, ATR TM-1280) ---
# Interruptor: el spec new-trip-other-costs CREA conceptos y viajes reales (los limpia al final).
# La familia npm run test:xray:othercosts lo fija en 1.
OTHER_COSTS_CREATE_DATA=
# Overrides de datos de other-costs.ts (cliente, origen, destino corto y destino largo).
# OC_CLIENT_QUERY=
# OC_ORIGIN_QUERY=
# OC_DESTINATION_QUERY=
# OC_LONG_DESTINATION_QUERY=
# Interruptor del happy path de alta de viaje. Ese spec CREA un viaje real
# (POST /carriers/<id>/travels) que queda en el tab Assign y hay que cancelar a mano, asi que
# esta skippeado salvo que se pida explicitamente. Dejar vacio salvo para correrlo a proposito.
MG19_CREATE_TRIP=

# ─── Xray — Test Plan por defecto del reporter ────────────────────────────────
# Default TM-1283 = ATP-AUTO (plan de stock de automatización MAGIIS).
# Override por campaña con XRAY_TEST_PLAN_KEY. Solo aplica si NO hay XRAY_EXECUTION_KEY.
XRAY_TEST_PLAN_KEY=TM-1283

# --- Finalizacion administrativa de viajes (TravelsClient.finalizeAdmin) ---
# DRIVER.ID (no USER_ID) con vehiculo vigente en el carrier del ambiente. Sin valor por defecto.
ADMIN_FINALIZE_DRIVER_ID=

# --- Cierre automatico por API del chofer (DriverTravelsClient) ---
# DRIVER.USER_ID del chofer de pruebas (assign/confirm). Sin valor por defecto.
AUTO_CLOSE_DRIVER_ID=
# Login del chofer: definir en .env.test (gitignored), nunca con valor aqui.
DRIVER_EMAIL=
DRIVER_PASSWORD=

# --- Circuito e2e carrier Francia (TEST carrier 1901) ---
# Credenciales con sufijo _FR (sin fallback a USER_CARRIER: la region FR nunca opera otro carrier).
# Definir en .env.<env> (gitignored), nunca con valor aqui.
USER_CARRIER_FR=
PASS_CARRIER_FR=
DRIVER_EMAIL_FR=
DRIVER_PASSWORD_FR=
# Datos del ambiente (fail-fast en getFrCircuitConfig si falta alguno).
FR_CLIENT_QUERY=
FR_CONTRACTOR_QUERY=
FR_ORIGIN_QUERY=
FR_DESTINATION_QUERY=
FR_OTHER_COST_NAME=
# DRIVER.ID (finalizeAdmin) y DRIVER.USER_ID (rendicion), vehiculo vigente y CHECKINGACCOUNT.ID.
FR_DRIVER_ID=
FR_DRIVER_USER_ID=
FR_VEHICLE_ID=
FR_CC_ID=
# Gates de acciones IRREVERSIBLES (solo el valor 1 las habilita; vacio = bloqueadas).
FR_CONFIRM_SURRENDER=
FR_EDIT_AFTER_SURRENDER=
FR_CIRCUIT_CREATE_TRIP=
# Rendicion AUTOMATICA (S4/S5): habilita escrituras en Carrier V2 Owners > Edit (Collects Cash / papelera del vehiculo).
FR_TOGGLE_AUTO_SURRENDER=
# Fase del flujo automatico: prepare | arm | fire | verify | disarm (vacio = specs auto saltados).
FR_AUTO_PHASE=
# Disparador: desvincular (default, inmediato por UI) | cron (job 13:10Z). Ambos pasan por arm/disarm.
FR_AUTO_MODE=
# Patente de la fila del vehiculo en Owners > Edit (default DNS207 = vehiculo 3765).
FR_VEHICLE_DOMAIN=

# --- Oracle SOLO LECTURA (tests/db/OracleDb.ts; mismos nombres que magiis-api-e2e) ---
# ENV=test usa el sufijo _TEST; ENV=uat las mismas sin sufijo. Valores solo en .env.<env> (gitignored).
# Connect string: ORACLE_CONNECT_STRING_TEST (host:puerto/service) o HOST+PORT+SERVICE.
ORACLE_USER_TEST=
ORACLE_PASSWORD_TEST=
ORACLE_HOST_TEST=
ORACLE_PORT_TEST=
ORACLE_SERVICE_TEST=
ORACLE_CONNECT_STRING_TEST=

# --- PK-B: oraculos admin y chofer (TM-1432 / TM-1427; plan docs/plans/PK-B-circuito-admin-chofer-2026-10-21.md) ---
# Vehiculo del chofer de ADMIN_FINALIZE_DRIVER_ID (TEST: el del 4987) para el lote de rendicion y la guarda del cron.
PKB_SURRENDER_VEHICLE_ID=
# Cliente y autorizador del tarifador 6203 (por costo). Vacio = «McLaren» / «Brown».
PKB_COST_CLIENT=
PKB_COST_AUTHORIZER=
# Gate de TM-1427 (red-first): falla con 500 hasta el fix de MG-1581. Solo el valor 1 lo habilita; vacio = spec saltado.
# Usa AUTO_CLOSE_DRIVER_ID como DRIVER.ID del chofer de las credenciales DRIVER_EMAIL.
PKB_TM1427_ENABLED=
